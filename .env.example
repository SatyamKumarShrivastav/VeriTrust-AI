# VeriTrust AI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=veritrust_ai

# ─── Security ───────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File Storage ───────────────────────────────────
UPLOAD_DIR=./storage/evidence
REPORTS_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=500
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm,mpeg

# ─── Cryptography ───────────────────────────────────
SIGNING_KEY_PATH=./keys/signing_key.pem
VERIFY_KEY_PATH=./keys/verify_key.pem

# ─── Blockchain ─────────────────────────────────────
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ─── Generative AI ──────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODE=template

# ─── Application ────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/veritrust.log

